{
  "manifest_version": 3,
  "name": "Spooky-Pass",
  "version": "0.1.0",
  "description": "Scary-good local-first autofill. Fill-on-click logins from your Spooky-Pass vault. 🦇",
  "minimum_chrome_version": "120",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["nativeMessaging", "activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Spooky-Pass",
    "default_popup": "popup.html"
  }
}
